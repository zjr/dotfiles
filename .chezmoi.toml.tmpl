{{ $name := promptString "name" "Zachary J. Rollyson" -}}
{{ $email := promptString "email" "zachary.rollyson@gsa.gov" -}}
{{ $gitkey := promptString "git signing key" -}}
{{ $computerName := output "scutil" "--get" "ComputerName" | trim -}}

[data]
  name = {{ $name | quote }}
  email = {{ $email | quote }}
  gitkey = {{ $gitkey | quote }}
  computerName = {{ coalesce $computerName .chezmoi.hostname | quote }}

[merge]
  command = "nvim"
  args = [
    "-d",
    "{{ "{{" }} .Destination {{ "}}" }}",
    "{{ "{{" }} .Source {{ "}}" }}",
    "{{ "{{" }} .Target {{ "}}" }}"
  ]

[[textconv]]
  command = "awk"
  pattern = "**/.config/fish/fish_variables"
  args = ["!/SETUVAR _.*/{print}"]
